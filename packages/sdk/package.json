{
  "name": "@kite-01/sdk",
  "version": "0.1.0",
  "description": "Server-side client for the Kite payments API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kite-01/monorepo.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsdown",
    "check": "tsc && tsc -p test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.0.0-next-20260930190945",
    "@types/node": "25.9.9"
  }
}
